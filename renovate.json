{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cgr.dev/chainguard/wolfi-base"],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$", "^apko\\.yaml$", "^melange\\.yaml$"],
      "matchStrings": ["KUBECTL_VERSION[=: ]+(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$", "^apko\\.yaml$", "^melange\\.yaml$"],
      "matchStrings": ["KUBELOGIN_VERSION[=: ]+(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "Azure/kubelogin",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$", "^apko\\.yaml$", "^melange\\.yaml$"],
      "matchStrings": ["TERRAFORM_VERSION[=: ]+(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$", "^apko\\.yaml$", "^melange\\.yaml$"],
      "matchStrings": ["VENDIR_VERSION[=: ]+(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "carvel-dev/vendir",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$", "^apko\\.yaml$", "^melange\\.yaml$"],
      "matchStrings": ["KLUCTL_VERSION[=: ]+(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "kluctl/kluctl",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$", "^melange\\.yaml$"],
      "matchStrings": ["az=(?<currentValue>[\\d.]+)-r\\d+"],
      "depNameTemplate": "Azure/azure-cli",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^azure-cli-(?<version>.+)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.ya?ml$"],
      "matchStrings": ["APKO_VERSION[=: ]+(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "chainguard-dev/apko",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
